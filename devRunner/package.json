    "start": "node dist/index.js",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "esbuild": "^0.25.9",
    "tsx": "^4.19.2",
    "typescript": "^5.2.2"
  }
}
